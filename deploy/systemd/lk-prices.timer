[Unit]
Description=Run lk-prices twice a day

[Timer]
# CBSL posts each report some time after the market day, at no fixed hour.
# Two runs a day catch it either way; a run with nothing new makes one request.
OnCalendar=*-*-* 10:00:00 Asia/Colombo
OnCalendar=*-*-* 20:00:00 Asia/Colombo
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
